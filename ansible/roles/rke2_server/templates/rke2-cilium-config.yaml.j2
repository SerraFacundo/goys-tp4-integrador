# Administrado por Ansible (rol rke2_server). Ver docs/05-cluster.md, Cilium
apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: rke2-cilium
  namespace: kube-system
spec:
  valuesContent: |-
    kubeProxyReplacement: true
    k8sServiceHost: {{ ansible_host }}
    k8sServicePort: 6443
    operator:
      replicas: 1
    hubble:
      enabled: true
      relay:
        enabled: true
      ui:
        enabled: true
        service:
          type: NodePort
          nodePort: 31235
    gatewayAPI:
      enabled: true
      hostNetwork:
        enabled: true
